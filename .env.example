# Copy this file to .env and fill in your real keys.
# Never commit .env to git.

# OpenAI API (required for `python update_resume.py`) - parses your resume
# into the search-criteria profile used by the whole tool.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Adzuna API (free) - https://developer.adzuna.com/signup
# Primary source for private-sector jobs. Sign up for instant app_id/app_key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional second aggregator - free key at https://jooble.org/api/about
# Skipped automatically if left blank.
JOOBLE_API_KEY=

# Bright Data API (optional, PAID/usage-billed) - LinkedIn job listings via
# their Dataset API. https://brightdata.com
# Skipped automatically if left blank.
BRIGHTDATA_API_KEY=

# USAJOBS API (free, optional - government/federal roles, off by default)
# https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_EMAIL=
